# OpenWebDav Configuration
# Copy this file to .env and modify as needed

# =============================================================================
# Database
# =============================================================================
# SQLite (default - good for small deployments)
DATABASE_URL=sqlite:///./data/openwebdav.db

# PostgreSQL (recommended for production)
# DATABASE_URL=postgresql+asyncpg://openwebdav:password@localhost:5432/openwebdav

# =============================================================================
# Security
# =============================================================================
SECRET_KEY=change-this-to-a-random-string-in-production
JWT_EXPIRY_MINUTES=60
JWT_REFRESH_EXPIRY_DAYS=7

# =============================================================================
# OIDC / SSO (optional)
# =============================================================================
OIDC_ENABLED=false
OIDC_PROVIDER_URL=https://your-idp.com/realms/your-realm
OIDC_CLIENT_ID=openwebdav
OIDC_CLIENT_SECRET=your-client-secret
OIDC_SCOPES=openid profile email
OIDC_REDIRECT_URI=http://localhost:8080/api/v1/auth/oidc/callback

# =============================================================================
# Storage
# =============================================================================
DEFAULT_STORAGE_PATH=/data/storage

# =============================================================================
# SLA Monitoring
# =============================================================================
SLA_CHECK_INTERVAL_MINUTES=15
SLA_ALERT_WEBHOOK_URL=
SLA_ALERT_EMAIL_FROM=noreply@openwebdav.local

# =============================================================================
# SMTP (for email alerts)
# =============================================================================
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# =============================================================================
# Application
# =============================================================================
APP_NAME=OpenWebDav
APP_URL=http://localhost:8080
LOG_LEVEL=info
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
